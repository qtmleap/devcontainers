{
  "name": "hono-vite-react-workers-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy --keep-vars",
    "typecheck": "tsc --noEmit",
    "lint": "bunx --bun biome check",
    "format": "bunx --bun biome check --write",
    "test": "bun test",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "commitlint": "^21.2.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "hono": "^4",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@cloudflare/vite-plugin": "^1",
    "@cloudflare/workers-types": "^4",
    "@playwright/mcp": "^0.0.81",
    "@types/bun": "^1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react-swc": "^4",
    "playwright": "^1.62.1",
    "typescript": "^7",
    "vite": "^8",
    "wrangler": "^4"
  }
}
