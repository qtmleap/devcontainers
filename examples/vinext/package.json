{
  "name": "vinext-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bunx vinext init",
    "dev": "bunx vinext dev",
    "build": "bunx vinext build",
    "start": "bunx vinext start",
    "check": "bunx vinext check",
    "deploy": "bunx @vinext/cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "lint": "bunx --bun biome check",
    "format": "bunx --bun biome check --write",
    "test": "bun test",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "commitlint": "^21.2.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "next": "^16",
    "react": "^19.2",
    "react-dom": "^19.2",
    "react-server-dom-webpack": "^19.2",
    "vinext": "latest",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@cloudflare/vite-plugin": "^1",
    "@cloudflare/workers-types": "^4",
    "@playwright/mcp": "^0.0.81",
    "@types/bun": "^1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "latest",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "latest",
    "playwright": "^1.62.1",
    "typescript": "^7",
    "vite": "^8",
    "wrangler": "^4"
  }
}
