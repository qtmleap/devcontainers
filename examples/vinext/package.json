{
  "name": "vinext-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bunx vinext init",
    "dev": "bunx vinext dev",
    "build": "bunx vinext build",
    "start": "bunx vinext start",
    "check": "bunx vinext check",
    "deploy": "bunx @vinext/cloudflare deploy",
    "typecheck": "tsc --noEmit",
