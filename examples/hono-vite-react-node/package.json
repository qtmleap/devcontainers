    "hono": "^4",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@hono/vite-build": "^1",
    "@hono/vite-dev-server": "^0.26",
    "@playwright/mcp": "0.0.82",
    "@types/bun": "^1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react-swc": "^4",
    "playwright": "^1.62.1",
    "typescript": "^7",
    "vite": "^8"
  }
