{
  "name": "hono-vite-react-node-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "start": "bun dist/index.js",
