{
  "name": "hono-vite-react-workers-prisma-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3",
  "workspaces": [
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "bun run --cwd workers/app dev",
    "dev:api": "bun run --cwd workers/api dev",
    "dev:db": "bun run --cwd workers/db dev",
    "build": "bun run --cwd workers/app build",
    "deploy": "bun --filter './workers/*' run deploy",
    "typecheck": "bun run --filter '@app/*' typecheck",
    "lint": "bunx --bun biome check",
    "format": "bunx --bun biome check --write",
    "test": "bun test",
    "db:generate": "bun run --cwd workers/db generate",
    "db:migrate": "bun run --cwd workers/db migrate"
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@cloudflare/workers-types": "^4",
    "@playwright/mcp": "0.0.82",
    "@types/bun": "^1",
    "@types/node": "^26",
    "playwright": "^1.62.1",
    "typescript": "^7",
    "wrangler": "^4"
  }
}
