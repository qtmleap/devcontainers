// `prisma-client` (not the legacy `prisma-client-js`) is required here: the old
// generator emits CommonJS into src/, where Vite applies no CJS interop, so the
// worker dies with a bare ReferenceError while workerd evaluates it as ESM.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "cloudflare"
  moduleFormat = "esm"
}

// Prisma 7 removed the schema-level `url` field. Runtime uses the adapter
// (see workers/db/src/index.ts) and `prisma migrate` uses the URL from
// prisma.config.ts.
datasource db {
  provider = "sqlite"
}

// Example model. Replace with the project's own domain.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}
